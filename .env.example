# PostgreSQL (e.g. Neon via the Vercel integration, which sets both automatically). DATABASE_URL_UNPOOLED = direct connection for migrations.
DATABASE_URL="postgresql://user:password@host:5432/drivemytruck"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/drivemytruck"
# Long random string (e.g. `openssl rand -base64 48`)
SESSION_SECRET=""
# Email that becomes ADMIN when registering (optional)
ADMIN_EMAIL=""
