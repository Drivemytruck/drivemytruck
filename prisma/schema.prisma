// Drive My Truck — data model (MVP)
// Money is stored in pence (Int) to avoid floating point issues.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  DRIVER
  COMPANY
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayType {
  SHIFT
  HOURLY
  ANNUAL
}

enum JobKind {
  SHIFT // one-off / ad-hoc shift
  PERMANENT // permanent or regular role
}

enum AvailabilitySlot {
  DAY
  NIGHT
  ANY
}

enum DocumentType {
  LICENCE
  CPC
  TACHO
  RIGHT_TO_WORK
  ADR
  OTHER
}

enum JobStatus {
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  INVITED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  SUPERSEDED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReliabilityEventType {
  NO_SHOW // driver didn't turn up (reported by company)
  LATE_CANCEL // cancelled less than 24h before the start
  CANCEL // cancelled with more notice (shown for context only)
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role
  suspended          Boolean   @default(false)
  avatarVersion      Int       @default(0) // bumps on every photo change, used for cache-busting
  sessionVersion     Int       @default(0) // bump to log the user out everywhere (e.g. after a password change)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  marketingConsent   Boolean   @default(false) // partner offers & discounts (opt-in, PECR)
  marketingConsentAt DateTime?
  locale             String    @default("en")
  createdAt          DateTime  @default(now())

  driver          DriverProfile?
  company         CompanyProfile?
  reviewsWritten  Review[]             @relation("ReviewAuthor")
  reviewsReceived Review[]             @relation("ReviewSubject")
  resetTokens     PasswordResetToken[]
  avatar          Avatar?
  reliability     ReliabilityEvent[]
  notifications   Notification[]
}

/// Track record used for reliability scores. Kept separately from bookings so that
/// history survives when a cancelled job is re-booked.
model ReliabilityEvent {
  id         String               @id @default(cuid())
  type       ReliabilityEventType
  userId     String // who the event counts against
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  jobId      String
  bookingId  String?
  overturned Boolean              @default(false) // e.g. no-show dispute accepted by admin
  createdAt  DateTime             @default(now())

  @@index([userId])
}

/// Profile photo / company logo, stored small (client resizes to ~320px JPEG).
model Avatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DriverProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  phone                 String?
  postcode              String?
  town                  String?
  lat                   Float?
  lng                   Float?
  travelRadiusMiles     Int                @default(25)
  licenceClasses        String[]
  skills                String[]
  experienceYears       Int?
  rateType              PayType            @default(SHIFT)
  rateAmount            Int? // pence
  bio                   String?
  availableToday        Boolean            @default(false)
  openToPermanent       Boolean            @default(false)
  permanentUntil        DateTime? // "looking for permanent work" expires after 30 days
  permEmployment        String[] // PAYE / Self-employed / Ltd / Umbrella
  permSchedule          String?
  permNote              String?
  permReminderSentAt    DateTime?
  availabilityUpdatedAt DateTime? // last time the driver added new available days
  jobAlertsEnabled      Boolean            @default(true) // emails about new jobs nearby
  lastJobDigestAt       DateTime?
  verificationStatus    VerificationStatus @default(PENDING)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  documents    DriverDocument[]
  availability Availability[]
  applications Application[]
  bookings     Booking[]
}

model DriverDocument {
  id        String             @id @default(cuid())
  driverId  String
  driver    DriverProfile      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      DocumentType
  reference String // e.g. last 8 chars of licence, DQC number, tacho card number, RTW share code
  checkCode String? // DVLA licence check code (valid 21 days)
  expiresAt DateTime?
  status    VerificationStatus @default(PENDING)
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([driverId, type])
}

model Availability {
  id         String           @id @default(cuid())
  driverId   String
  driver     DriverProfile    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  slot       AvailabilitySlot @default(ANY) // legacy, kept for old rows
  startTime  String? // "HH:MM" London time; null = any time
  endTime    String? // "HH:MM"; may be earlier than startTime for overnight
  rateAmount Int? // pence; null = use profile rate
  rateType   PayType?

  @@unique([driverId, date])
  @@index([date])
}

model CompanyProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName          String
  companiesHouseNumber String?
  operatorLicence      String?
  contactName          String?
  phone                String?
  postcode             String?
  town                 String?
  lat                  Float?
  lng                  Float?
  about                String?
  verificationStatus   VerificationStatus @default(PENDING)
  alertsEnabled        Boolean            @default(true) // emails about drivers becoming available nearby
  alertRadiusMiles     Int                @default(30)
  alertClasses         String[] // empty = any class
  lastDigestAt         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  jobs     Job[]
  bookings Booking[]
}

model Job {
  id                   String         @id @default(cuid())
  companyId            String
  company              CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  licenceClass         String
  postcode             String
  town                 String?
  lat                  Float?
  lng                  Float?
  kind                 JobKind        @default(SHIFT)
  startAt              DateTime // shift start, or role start date for permanent jobs
  startAsap            Boolean        @default(false)
  durationHours        Float          @default(0) // shifts only
  schedule             String? // permanent: e.g. "Mon–Fri nights", "4 on 4 off"
  employmentType       String? // permanent: PAYE / Self-employed / Ltd / Umbrella
  benefits             String?
  expiresAt            DateTime? // permanent adverts are live for 14 days, then renewed
  renewCount           Int            @default(0)
  expiryReminderSentAt DateTime?
  payType              PayType        @default(SHIFT)
  payAmount            Int // pence
  jobType              String?
  vehicleType          String?
  description          String?
  requirements         String?
  status               JobStatus      @default(OPEN)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  applications Application[]
  booking      Booking?

  @@index([status, startAt])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId  String
  driver    DriverProfile     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  offers    Offer[]

  @@unique([jobId, driverId])
}

model Booking {
  id              String         @id @default(cuid())
  jobId           String         @unique
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId        String
  driver          DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  companyId       String
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          BookingStatus  @default(CONFIRMED)
  agreedPayAmount Int? // pence; null = advertised pay
  agreedPayType   PayType?
  agreedStartAt   DateTime? // null = advertised start
  completedAt     DateTime?
  noShowAt        DateTime?
  disputeText     String? // driver's side if they dispute a no-show
  disputeStatus   String? // OPEN | UPHELD | OVERTURNED
  createdAt       DateTime       @default(now())

  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  hidden    Boolean  @default(false) // admin moderation
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

/// Failed login attempts, used to slow down password guessing.
model FailedLogin {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// Record of admin actions (who did what, when) for accountability.
model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String
  action    String // e.g. VERIFY_DOCUMENT, SUSPEND_USER, RESET_PASSWORD
  targetId  String? // user / document / booking id
  detail    String?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([createdAt])
}

/// One email per (job, driver) when a driver's new availability matches an open job.
model JobMatchAlert {
  id        String   @id @default(cuid())
  jobId     String
  driverId  String
  createdAt DateTime @default(now())

  @@unique([jobId, driverId])
}

/// One email per (job, driver) when a new job matches the driver.
model DriverJobAlert {
  id        String   @id @default(cuid())
  jobId     String
  driverId  String
  createdAt DateTime @default(now())

  @@unique([jobId, driverId])
  @@index([driverId, createdAt])
}

/// In-app notifications (the bell). Text is stored in the recipient's language at creation.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String    @default("🔔")
  title     String
  body      String?
  link      String? // path inside the site, e.g. /jobs/abc
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Negotiation on a shift: proposed pay and/or start time. One PENDING offer per application at a time.
model Offer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  byRole        Role // DRIVER or COMPANY
  payAmount     Int // pence
  payType       PayType
  startAt       DateTime
  note          String?
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  @@index([applicationId, status])
}
